cmake_minimum_required (VERSION 3.10)

if ("${LIB_BUILD_TYPE}" MATCHES "STATIC")
    message(STATUS "Build using private code")
	add_subdirectory(${CMAKE_CURRENT_LIST_DIR}/../../../SDK_dev/lib build/ultimateALPR/SDK_dev)
	set(SDK_DIST_CPP_ALPR_SDK ultimate_alpr-sdk)
else ()
    message(STATUS "Build using public code")
	if (${CMAKE_SYSTEM_PROCESSOR} MATCHES "amd64|x86_64|AMD64" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
		set(TARGET_ARCH "x86_64")
	elseif (${CMAKE_SYSTEM_PROCESSOR} MATCHES "^aarch64")
		set(TARGET_ARCH "aarch64")
	else()
		message(FATAL_ERROR "Arch not supported: ${CMAKE_SYSTEM_PROCESSOR}")
	endif()
	if (WIN32)
		set(SDK_DIST_CPP_ALPR_SDK ${CMAKE_CURRENT_LIST_DIR}/../../binaries/windows/${TARGET_ARCH}/ultimateALPR-SDK.lib)
	else ()
		set(SDK_DIST_CPP_ALPR_SDK ${CMAKE_CURRENT_LIST_DIR}/../../binaries/linux/${TARGET_ARCH}/libultimate_alpr-sdk.so)
	endif ()
endif ()